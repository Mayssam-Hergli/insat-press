DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-only. Never expose to the client or prefix with NEXT_PUBLIC_.
# Used to invite/manage Supabase auth users from the admin Team section.
# Find it in the Supabase dashboard under Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

NODE_ENV="development"

# --- One-off import scripts (npm run import:facebook / import:youtube) ---
# Not used by the app itself, only by scripts/import-*.ts.

# Email of an existing admin Profile to attribute imported drafts to.
IMPORT_PROFILE_EMAIL="admin@example.com"

# Meta Graph API. Generate via https://developers.facebook.com/tools/explorer/
# (select your app, "Get Page Access Token" for the INSAT Press page, with the
# pages_read_engagement and pages_show_list permissions).
FACEBOOK_PAGE_ID="your-page-id"
FACEBOOK_PAGE_ACCESS_TOKEN="your-page-access-token"

# YouTube Data API v3. Create a key at https://console.cloud.google.com
# (APIs & Services > Credentials, after enabling "YouTube Data API v3").
YOUTUBE_API_KEY="your-youtube-api-key"
YOUTUBE_CHANNEL_ID="your-channel-id"
