generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum ContentStatus {
  DRAFT     @map("draft")
  PENDING   @map("pending")
  PUBLISHED @map("published")
  ARCHIVED  @map("archived")

  @@map("content_status")
}

enum AdminRole {
  ADMIN  @map("admin")
  WRITER @map("writer")
  MEDIA  @map("media")

  @@map("admin_role")
}

model Profile {
  id        String    @id @db.Uuid
  email     String    @unique
  fullName  String?   @map("full_name")
  role      AdminRole @default(WRITER)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  articlesCreated Article[]        @relation("ArticleCreatedBy")
  articlesUpdated Article[]        @relation("ArticleUpdatedBy")
  eventsCreated   Event[]          @relation("EventCreatedBy")
  eventsUpdated   Event[]          @relation("EventUpdatedBy")
  mediaCreated    MediaCoverage[]  @relation("MediaCreatedBy")
  mediaUpdated    MediaCoverage[]  @relation("MediaUpdatedBy")
  podcastsCreated PodcastEpisode[] @relation("PodcastCreatedBy")
  podcastsUpdated PodcastEpisode[] @relation("PodcastUpdatedBy")

  @@map("profiles")
}

model Writer {
  id        BigInt          @id @default(autoincrement())
  name      String
  slug      String          @unique
  bio       String?
  avatarUrl String?         @map("avatar_url")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  articles  ArticleWriter[]

  @@index([name])
  @@map("writers")
}

model Article {
  id          BigInt          @id @default(autoincrement())
  slug        String          @unique
  title       String
  category    String
  description String
  content     String          @default("")
  coverImage  String?         @map("cover_image")
  coverLabel  String?         @map("cover_label")
  sourceUrl   String?         @map("source_url")
  displayDate String?         @map("display_date")
  status      ContentStatus   @default(DRAFT)
  publishedAt DateTime?       @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?         @map("created_by_id") @db.Uuid
  updatedById String?         @map("updated_by_id") @db.Uuid
  writers     ArticleWriter[]
  createdBy   Profile?        @relation("ArticleCreatedBy", fields: [createdById], references: [id])
  updatedBy   Profile?        @relation("ArticleUpdatedBy", fields: [updatedById], references: [id])

  @@index([status, publishedAt])
  @@index([category])
  @@index([createdById])
  @@index([updatedById])
  @@map("articles")
}

model ArticleWriter {
  articleId BigInt  @map("article_id")
  writerId  BigInt  @map("writer_id")
  sortOrder Int     @default(0) @map("sort_order")
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  writer    Writer  @relation(fields: [writerId], references: [id], onDelete: Cascade)

  @@id([articleId, writerId])
  @@index([writerId])
  @@index([articleId, sortOrder])
  @@map("article_writers")
}

model Event {
  id          BigInt        @id @default(autoincrement())
  slug        String        @unique
  title       String
  type        String
  edition     String?
  description String
  content     String        @default("")
  coverImage  String?       @map("cover_image")
  coverLabel  String?       @map("cover_label")
  displayDate String?       @map("display_date")
  startsAt    DateTime?     @map("starts_at") @db.Timestamptz(6)
  location    String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?       @map("created_by_id") @db.Uuid
  updatedById String?       @map("updated_by_id") @db.Uuid
  createdBy   Profile?      @relation("EventCreatedBy", fields: [createdById], references: [id])
  updatedBy   Profile?      @relation("EventUpdatedBy", fields: [updatedById], references: [id])

  @@index([status, publishedAt])
  @@index([type])
  @@index([startsAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("events")
}

model PodcastEpisode {
  id          BigInt        @id @default(autoincrement())
  slug        String        @unique
  title       String
  host        String
  editedBy    String
  guest       String
  description String
  content     String        @default("")
  coverImage  String?       @map("cover_image")
  coverLabel  String?       @map("cover_label")
  youtubeUrl  String        @map("youtube_url")
  spotifyUrl String         @map("spotify_url")
  displayDate String?       @map("display_date")
  releasedAt  DateTime?     @map("released_at") @db.Timestamptz(6)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?       @map("created_by_id") @db.Uuid
  updatedById String?       @map("updated_by_id") @db.Uuid
  createdBy   Profile?      @relation("PodcastCreatedBy", fields: [createdById], references: [id])
  updatedBy   Profile?      @relation("PodcastUpdatedBy", fields: [updatedById], references: [id])

  @@index([status, publishedAt])
  @@index([releasedAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("podcast_episodes")
}

model MediaCoverage {
  id          BigInt              @id @default(autoincrement())
  slug        String              @unique
  title       String
  coveredBy   String
  editedBy    String
  eventName   String              @map("event_name")
  type        String
  description String
  content     String              @default("")
  coverImage  String?             @map("cover_image")
  coverLabel  String?             @map("cover_label")
  displayDate String?             @map("display_date")
  coveredAt   DateTime?           @map("covered_at") @db.Timestamptz(6)
  status      ContentStatus       @default(DRAFT)
  publishedAt DateTime?           @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?             @map("created_by_id") @db.Uuid
  updatedById String?             @map("updated_by_id") @db.Uuid
  createdBy   Profile?            @relation("MediaCreatedBy", fields: [createdById], references: [id])
  updatedBy   Profile?            @relation("MediaUpdatedBy", fields: [updatedById], references: [id])
  gallery     MediaGalleryImage[]

  @@index([status, publishedAt])
  @@index([type])
  @@index([coveredAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("media_coverage")
}

model MediaGalleryImage {
  id              BigInt        @id @default(autoincrement())
  mediaCoverageId BigInt        @map("media_coverage_id")
  src             String?
  alt             String?
  label           String
  caption         String?
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  mediaCoverage   MediaCoverage @relation(fields: [mediaCoverageId], references: [id], onDelete: Cascade)

  @@index([mediaCoverageId, sortOrder])
  @@map("media_gallery_images")
}


