DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Server-only. Never expose to the client or prefix with NEXT_PUBLIC_.
# Used to invite/manage Supabase auth users from the admin Team section.
# Find it in the Supabase dashboard under Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

NODE_ENV="development"
